# 配置项示例：Spring Boot 和 IDEA 不会自动加载本文件。
# 请将需要的值设置到终端环境变量或 IDEA Run Configuration；不要在此填写并提交真实密码。
RIKE_TIKU_DB_HOST=localhost
RIKE_TIKU_DB_PORT=3306
RIKE_TIKU_DB_NAME=rike_tiku
RIKE_TIKU_DB_USERNAME=root
RIKE_TIKU_DB_PASSWORD=replace-with-your-local-password
RIKE_TIKU_BACKEND_PORT=8081
RIKE_TIKU_CORS_ALLOWED_ORIGINS=http://localhost:8080
